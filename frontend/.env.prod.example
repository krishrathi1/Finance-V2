# Production env for the Next.js app (server + API routes).
# Copy to .env.prod (gitignored) and fill in real values — never commit them.

NEXT_PUBLIC_API_BASE=https://mystockvision.com
INTERNAL_API_BASE=http://127.0.0.1:3000

# Auth — required, no default. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
JWT_SECRET_KEY=

# MySQL — when deploying via docker-compose.prod.yml these are injected by
# the compose file from the root .env's MYSQL_ROOT_PASSWORD; only set them
# here for non-compose deploys.
# MYSQL_HOST=
# MYSQL_USER=
# MYSQL_PASSWORD=
# MYSQL_DATABASE=financial_forensics

# Email (verification + password reset OTP)
SMTP_SERVER=
SMTP_PORT=587
SMTP_EMAIL=
SMTP_PASSWORD=

# Data / AI providers
FMP_API_KEY=
NEWS_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview

# Rate limiting — strongly recommended once running more than one container
# (e.g. docker-compose scale, multiple replicas): without these, each
# container has its own independent in-memory rate-limit counters, so a
# client can get up to N x limit through by hitting different containers.
# Free tier: https://console.upstash.com
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
