NEXT_PUBLIC_API_BASE=http://localhost:3000
INTERNAL_API_BASE=http://localhost:3000

# Auth — required (32+ chars). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
JWT_SECRET_KEY=

# MySQL (local dev)
MYSQL_HOST=localhost
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=financial_forensics

# Email (verification + password reset OTP, price alert notifications)
# — optional in dev
SMTP_SERVER=
SMTP_PORT=587
SMTP_EMAIL=
SMTP_PASSWORD=

# Data / AI providers
FMP_API_KEY=
NEWS_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview

# Rate limiting — optional. Unset = per-instance in-memory limiter (fine for
# a single container). Set both to share limits across multiple instances via
# Upstash Redis (works in Edge middleware; REST-based, no TCP client needed).
# Free tier: https://console.upstash.com
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Price alert sweep — optional. When set, a scheduled job can evaluate every
# user's alerts (and email the ones that fired) by POSTing to
# /api/v1/alerts/evaluate with an `x-cron-secret` header matching this value:
#   curl -fsS -X POST http://127.0.0.1:3000/api/v1/alerts/evaluate \
#        -H "x-cron-secret: $ALERTS_CRON_SECRET"
# Leave it unset and alerts are still evaluated, but only while a signed-in
# user has the alerts page open — which defeats the point of an alert.
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ALERTS_CRON_SECRET=
