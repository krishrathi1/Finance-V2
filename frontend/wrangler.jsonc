{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "finance",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-03-17",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": ".open-next/assets"
  },
  "vars": {
    "NEXT_PUBLIC_API_BASE": "https://financial-forensics-ai-india.onrender.com",
    "INTERNAL_API_BASE": "https://financial-forensics-ai-india.onrender.com"
  }
}
