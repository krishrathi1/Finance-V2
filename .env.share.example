# Copy this file to ".env" beside docker-compose.share.yml and fill it in.
#
#   cp .env.share.example .env
#
# Nothing here is inside the image — the image is generic, this file is what
# makes it yours. Keep it off version control and off shared drives.

# ─── Required ────────────────────────────────────────────────────────────────

# Database password. Any strong random string; you never type it again.
#   openssl rand -base64 24
MYSQL_ROOT_PASSWORD=

# Signs login sessions. Must be 32+ characters and must NOT be shared with
# anyone — whoever holds it can mint a session for any account.
#   openssl rand -base64 32
JWT_SECRET_KEY=

# ─── Optional: the app runs without these, with features degraded ────────────

# Market data. Without a key the app falls back to NSE and Yahoo, which cover
# most of the page; some fundamentals and the IPO calendar go quiet.
#   Free tier: https://site.financialmodelingprep.com/developer/docs
FMP_API_KEY=

# News. Without it, news falls back to Google News RSS.
#   Free tier: https://newsapi.org
NEWS_API_KEY=

# AI features (research reports, SWOT, screener in plain English). Without a
# key every AI feature falls back to its rule-based version rather than
# failing — nothing on the page breaks.
#   Free tier: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Email: verification links, password-reset OTPs and price-alert notifications.
# Leave blank and account signup still works, but nobody receives mail.
# For Gmail use an App Password, not the account password.
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=
SMTP_PASSWORD=

# Price-alert sweep. Alerts are evaluated by a scheduled POST to
# /api/v1/alerts/evaluate carrying this value as the x-cron-secret header.
# Without it, alerts only evaluate while someone has the alerts page open —
# which defeats the point of an alert. See DEPLOY.md for the crontab line.
#   openssl rand -base64 32
ALERTS_CRON_SECRET=

# Rate limiting across more than one container. With a single container the
# built-in in-memory limiter is correct; with several, each keeps its own
# counters and a caller gets N x the limit through.
#   Free tier: https://console.upstash.com
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── Deployment knobs ────────────────────────────────────────────────────────

# Host port. Change if 3000 is taken.
APP_PORT=3000

# Which image to run. Leave as-is after `docker load`; point it at a registry
# path instead if you push the image somewhere.
APP_IMAGE=mystockvision:latest

# Database name. Changing this after first boot starts an empty database.
MYSQL_DATABASE=financial_forensics
