# Root-level env file for docker-compose.prod.yml variable substitution.
# Copy to ".env" in this same directory (gitignored) before running:
#   docker compose -f docker-compose.prod.yml up -d --build
#
# Generate strong values with:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"

POSTGRES_PASSWORD=
