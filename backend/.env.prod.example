APP_NAME=Financial Forensics AI API
APP_ENV=production
APP_DEBUG=false

# When running via docker-compose.prod.yml, these two are overridden at
# deploy time from the root .env's POSTGRES_PASSWORD/REDIS_PASSWORD — the
# values below only apply to non-compose deploys.
DATABASE_URL=postgresql+asyncpg://ffa:CHANGE_ME@postgres:5432/financial_forensics
REDIS_URL=redis://:CHANGE_ME@redis:6379/0

# API Keys (fill in your own production keys — never commit this file with real values)
FMP_API_KEY=
NEWS_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview

# Storage
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_ENDPOINT=
S3_BUCKET=
CORS_ORIGINS=http://mystockvision.com,https://mystockvision.com,http://www.mystockvision.com,https://www.mystockvision.com

# Auth — required, no default. Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=

# SMTP
SMTP_SERVER=
SMTP_PORT=587
SMTP_EMAIL=
SMTP_PASSWORD=
